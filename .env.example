# Database Settings (PostgreSQL + pgvector)
POSTGRES_DB=covenant_ai
POSTGRES_USER=covenant_user
POSTGRES_PASSWORD=covenant_secure_pass_2026
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Application DB connection
DATABASE_URL=postgresql+psycopg://covenant_user:covenant_secure_pass_2026@localhost:5432/covenant_ai
# Planned: workflow currently uses MemorySaver unless a checkpointer is injected.
LANGGRAPH_CHECKPOINTER_URI=postgresql://covenant_user:covenant_secure_pass_2026@localhost:5432/covenant_ai

# Planned cache / message broker; no current workflow code uses Redis.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# SEC EDGAR Settings (required by SEC Fair Access policy: Name Email)
SEC_USER_AGENT=YourName your-email@example.com
EDGAR_CACHE_DIR=ai/src/covenant_ai/.edgar_cache
MARKET_PRICE_SNAPSHOT_CSV=market_price_snapshots.csv

# LLM Settings (configure locally in .env; omit GEMINI_API_KEY for deterministic offline mode)
# GEMINI_API_KEY=your_gemini_api_key_here
# COVENANT_FAST_MODEL=
# COVENANT_WRITER_MODEL=
# Optional override forcing a single model across both tasks:
# COVENANT_LLM_MODEL=
