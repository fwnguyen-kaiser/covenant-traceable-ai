erDiagram
  USER ||--o{ CASE : owns
  USER ||--o{ CASE_MEMBERSHIP : "assigned as"
  CASE ||--o{ CASE_MEMBERSHIP : grants
  USER ||--o{ AUDIT_LOG : acts
  CASE ||--o{ COMPANY_PROFILE : versions
  CASE ||--o{ ANALYSIS_RUN : executes
  COMPANY_PROFILE ||--o{ ANALYSIS_RUN : "frozen profile"
  ANALYSIS_RUN ||--o{ PEER_CANDIDATE : scores
  ANALYSIS_RUN ||--o{ FINANCIAL_DATAPOINT : freezes
  ANALYSIS_RUN ||--o| VALUATION_RESULT : produces
  ANALYSIS_RUN ||--o| REPORT_APPROVAL : "releases digest"
  ANALYSIS_RUN ||--o{ REPORT_REVIEW_EVENT : tracks
  ANALYSIS_RUN ||--o{ RUN_COMMAND : "deduplicates turns"
  ANALYSIS_RUN ||--o{ CHAT_MESSAGE : logs
  PEER_COMPANY ||..o{ PEER_CANDIDATE : "referenced ticker"

  USER {
    uuid id PK
    string email
    string password_hash
    string role "analyst | reviewer | admin"
    boolean is_active
    boolean can_release_report
    boolean credentials_verified
    bigint django_user_id "1:1 link to Django auth_user"
    timestamp created_at
  }
  CASE {
    uuid id PK
    uuid owner_id FK
    string company_name
    string status "active | archived"
    string management_mode "legacy_cli | web_managed"
    timestamp archived_at
    uuid archived_by FK
    timestamp created_at
    timestamp updated_at
  }
  CASE_MEMBERSHIP {
    uuid id PK
    uuid case_id FK
    uuid user_id FK
    string role "analyst | reviewer | release_admin"
    uuid assigned_by FK
    timestamp created_at
  }
  COMPANY_PROFILE {
    uuid id PK
    uuid case_id FK
    int version "unique (case_id, version)"
    string industry
    string geography
    numeric revenue
    numeric ebitda
    numeric total_debt
    numeric cash
    jsonb extra "intake_answers + profile_digest + schedule"
    timestamp created_at
  }
  ANALYSIS_RUN {
    uuid id PK
    uuid case_id FK
    uuid profile_id FK
    string status "running | completed | insufficient_peers | failed"
    string review_status "draft | submitted | reviewed | changes_requested | released"
    string thread_id "unique LangGraph thread_id"
    jsonb review_packet "frozen packet + lineage + sources + method_version"
    uuid submitted_by FK
    uuid reviewed_by FK
    uuid released_by FK
    text review_comment
    timestamp started_at
    timestamp finished_at
  }
  PEER_COMPANY {
    string ticker PK
    string cik
    string company_name
    string industry
    string sic_code
    string exchange
    string ev_tier
    string sub_industry
    string customer_type "b2b | b2c | gov | mixed"
    boolean ev_ebitda_eligible
    uuid baseline_id
    jsonb baseline_errors
    boolean verified
  }
  PEER_CANDIDATE {
    uuid id PK
    uuid run_id FK
    string ticker
    int rank_order
    numeric total_score
    numeric business_score
    numeric financial_score
    numeric size_distance
    string status "selected | reserve | failed | disqualified"
    jsonb rationale
    text drop_reason
  }
  FINANCIAL_DATAPOINT {
    uuid id PK
    uuid origin_id "lineage origin UUID before run copy"
    uuid baseline_id "NULL on run snapshots"
    uuid run_id FK "NULL = seeded baseline"
    string peer_ticker "NULL = target company"
    string metric
    numeric value
    string currency
    string period "FY | LTM"
    date period_end
    string source_type "user_provided | sec_filing | market_data"
    text source_ref
    timestamp retrieved_at
  }
  VALUATION_RESULT {
    uuid id PK
    uuid run_id FK
    numeric ev_low
    numeric ev_mid
    numeric ev_high
    numeric equity_low
    numeric equity_mid
    numeric equity_high
    jsonb multiples_used
    jsonb sales_multiples_used
    jsonb peer_stats
    jsonb outlier_flags
    jsonb excluded_peers
    text[] limitations
    text explanation_md
    string audit_verdict
    jsonb audit_findings
    string prompt_version
  }
  REPORT_APPROVAL {
    uuid run_id PK
    text digest "SHA-256 of canonical review_packet"
    text reviewer_sid
    uuid actor_id FK
    string actor_type "windows_sid | web_user"
    timestamptz approved_at
  }
  REPORT_REVIEW_EVENT {
    uuid id PK
    uuid run_id FK
    string stage "submitted | reviewed | changes_requested | released"
    text digest
    uuid actor_id FK
    string actor_type "web_user | windows_sid"
    text comment
    timestamptz created_at
  }
  RUN_COMMAND {
    uuid id PK
    uuid run_id FK
    string thread_id
    string client_message_id "unique (run_id, client_message_id)"
    string prompt_id
    text command_hash
    string status "pending | applied | failed"
    jsonb response_payload
    uuid actor_id FK
  }
  CHAT_MESSAGE {
    uuid id PK
    uuid run_id FK
    int seq_no "unique (run_id, seq_no)"
    string sender_type "agent | user | system"
    string message_type "prompt | answer | status | draft_link | error"
    string prompt_id
    string client_message_id
    text body
    jsonb payload
  }
  AUDIT_LOG {
    uuid id PK
    uuid actor_id FK
    string action
    string entity_type
    uuid entity_id
    int decision_index "unique (entity_id, decision_index)"
    jsonb detail
    timestamp created_at
  }
